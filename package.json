{
  "name": "dsh-memwiki",
  "version": "0.1.0",
  "description": "多个 AI 共用的记忆 wiki：Markdown/Obsidian 库 + MCP 服务，DeepSeek Harness、Claude Code、Codex、Cursor 通用。 · Shared memory wiki for AI agents: an Obsidian-compatible Markdown vault served over MCP.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-memwiki": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-host": {
      "types": "./lib/dsh/host.d.ts",
      "default": "./lib/dsh-host.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "templates",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && bun run scripts/build-host.mjs && bun run scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:bundles": "node scripts/check-bundles.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": ["@deepseek-ai/dsh-client-ui-slots", "@deepseek-ai/dsh-client-locale"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "memory",
    "wiki",
    "obsidian",
    "knowledge-base",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.9"
  }
}
